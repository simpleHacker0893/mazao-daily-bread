# Copy to .env (git-ignored) and fill in. Never commit real values.
# Neon vars are written for you by `neon env pull` / `neon deploy` (project linked in .neon).

# Neon Postgres (Prisma 8, D-048)
DATABASE_URL=            # pooled URL, app runtime
DATABASE_URL_UNPOOLED=   # direct URL, Prisma CLI / migrations
NEON_BRANCH=

# Neon Object Storage (bucket "assets", declared in neon.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Clerk (added with the Clerk setup)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
