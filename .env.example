# Copy to .env (git-ignored) and fill in. Never commit real values.
# Neon vars are written for you by `neon env pull` / `neon deploy` (project linked in .neon).

# Neon Postgres (Prisma 8, D-048)
DATABASE_URL=            # pooled URL, app runtime
DATABASE_URL_UNPOOLED=   # direct URL, Prisma CLI / migrations
NEON_BRANCH=

# Neon Object Storage (bucket "assets", declared in neon.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Clerk (app_3L8uFOUNkjToZiKTMKFjuraVa69). Sign-in URLs and redirects are set in auth/clerk.tsx
# and proxy.ts, so only the keys are needed here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# e2e only: the Clerk development test user (a +clerk_test address; no email is sent)
E2E_CLERK_USER_EMAIL=
